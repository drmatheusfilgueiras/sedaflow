function renderAgendaCalendar(entries,selectedEntry,monthValue) {
  const [y,m]=monthValue.split("-").map(Number);
  const firstDay=new Date(y,m-1,1),lastDay=new Date(y,m,0).getDate(),startOffset=firstDay.getDay();
  const today=new Date().toISOString().slice(0,10),selectedDate=selectedEntry?.date||"";
  const ebd=entries.reduce((map,e)=>{if(!e.date)return map;if(!map[e.date])map[e.date]=[];map[e.date].push(e);return map;},{});
  const cells=[];
  for(let i=0;i<startOffset;i++)cells.push('<div class="calendar-empty"></div>');
  for(let day=1;day<=lastDay;day++){
    const dv=`${monthValue}-${String(day).padStart(2,"0")}`;
    const de=ebd[dv]||[];
    const isSel=selectedDate===dv,isTod=today===dv;
    const tc=getScheduleToneClass(de);
    const fp=de[0]?.patientId?getPatientNameById(de[0].patientId):"Sem paciente";
    cells.push(`<button class="calendar-day-card ${isSel?"selected":""} ${isTod?"today":""} ${de.length?"has-entries":""}${tc}" type="button" data-action="open-schedule-day" data-schedule-date="${dv}"><strong>${day}</strong><span>${de.length?`${de.length} consulta(s)`:"Livre"}</span><small>${escapeHtml(de.length?fp:"Clique para agendar")}</small></button>`);
  }
  return `<div class="calendar-weekdays">${["Dom","Seg","Ter","Qua","Qui","Sex","Sáb"].map(l=>`<span>${l}</span>`).join("")}</div><div class="calendar-grid">${cells.join("")}</div>`;
}

function getScheduleToneClass(entries) {
  const arr=Array.isArray(entries)?entries:[entries].filter(Boolean);
  if(arr.some(e=>e?.appointmentType==="Sedação agendada")) return " schedule-tone-sedation";
  if(arr.some(e=>e?.appointmentType==="Avaliação pré-sedação")) return " schedule-tone-assessment";
  return "";
}

