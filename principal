function textField(label,path,value,span="span-4",type="text",placeholder=""){return`<label class="field ${span}"><span>${label}</span><input type="${type}" data-path="${path}" value="${escapeHtml(value)}" placeholder="${escapeHtml(placeholder)}" /></label>`;}
function textAreaField(label,path,value,span="span-12",placeholder=""){return`<label class="field ${span}"><span>${label}</span><textarea data-path="${path}" placeholder="${escapeHtml(placeholder)}">${escapeHtml(value)}</textarea></label>`;}
function selectField(label,path,value,options,span="span-4"){const opts=options.map(o=>typeof o==="string"?{value:o,label:o}:o);return`<label class="field ${span}"><span>${label}</span><select data-path="${path}"><option value="">Selecione</option>${opts.map(o=>`<option value="${escapeHtml(o.value)}" ${String(value)===String(o.value)?"selected":""}>${escapeHtml(o.label)}</option>`).join("")}</select></label>`;}
function readonlyAgeField(label,value,span="span-4"){return`<label class="field ${span}"><span>${label}</span><input type="text" value="${escapeHtml(value)}" data-derived-age="true" readonly /></label>`;}
function sessionField(label,field,value,span="span-4",type="text",step=""){const sa=step?` step="${step}"`:"";return`<label class="field ${span}"><span>${label}</span><input type="${type}"${sa} data-session-field="${field}" value="${escapeHtml(value)}" /></label>`;}
function sessionReadonlyField(label,value,span="span-4"){return`<label class="field ${span}"><span>${label}</span><input type="text" value="${escapeHtml(value)}" readonly /></label>`;}
function sessionTextArea(label,field,value,span="span-12"){return`<label class="field ${span}"><span>${label}</span><textarea data-session-field="${field}">${escapeHtml(value)}</textarea></label>`;}
function sessionSelect(label,field,value,options,span="span-4"){const opts=options.map(o=>typeof o==="string"?{value:o,label:o}:o);return`<label class="field ${span}"><span>${label}</span><select data-session-field="${field}"><option value="">Selecione</option>${opts.map(o=>`<option value="${escapeHtml(o.value)}" ${String(value)===String(o.value)?"selected":""}>${escapeHtml(o.label)}</option>`).join("")}</select></label>`;}
function settingsField(label,path,value,span="span-4",type="number",step="0.01"){const sa=type==="number"?` step="${step}"`:"";return`<label class="field ${span}"><span>${label}</span><input type="${type}"${sa} data-settings-path="${path}" value="${escapeHtml(value)}" /></label>`;}

