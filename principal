  <table><tr><td>EVA de ansiedade</td><td>${p.anxiety.evaScore||"—"} / 10</td></tr><tr><td>MDAS</td><td>${mdasScore} / 25 — ${getMdasClassification(mdasScore)}</td></tr></table>
  <h2>Sessões de Sedação (${p.sessions.length})</h2>
  ${p.sessions.length===0?'<p>Nenhuma sessão registrada.</p>':p.sessions.map(s=>`<table><tr><td>Data</td><td>${formatDate(s.date)}</td></tr><tr><td>Procedimento</td><td>${s.procedure||"—"}</td></tr><tr><td>Profissional sedacionista</td><td>${s.clinician||SEDATION_PROFESSIONAL}</td></tr><tr><td>SpO2 basal</td><td>${s.spo2Baseline||"—"}</td></tr><tr><td>N2O inicial</td><td>${s.initialNitrous||"—"}%</td></tr><tr><td>Tempo total</td><td>${s.totalSedationTime||"—"}</td></tr><tr><td>Wilson na alta</td><td>${s.dischargeWilson||"—"}</td></tr></table>`).join("")}
  </body></html>`;
  const w = window.open("", "_blank");
  if (!w) { alert("O navegador bloqueou a nova aba. Habilite popups para este site."); return; }
  w.document.write(html);
  w.document.close();
  w.focus();
  setTimeout(() => w.print(), 400);
}

