function renderPatientsOverview() {
  if(!state.patients.length) return `<article class="surface-card section-block"><p class="eyebrow">Pacientes</p><h3 class="finance-title">Nenhum paciente cadastrado</h3></article>`;
  return `<article class="surface-card section-block"><p class="eyebrow">Pacientes</p><h3 class="finance-title">Lista completa de pacientes</h3>
  <div class="overview-stack">${state.patients.map(p=>`<button class="overview-card overview-card-button" type="button" data-action="open-patient-record" data-patient-id="${p.id}"><div class="overview-card-head"><strong>${escapeHtml(p.profile.fullName||"Paciente sem nome")}</strong><span class="overview-chip">${p.sessions.length} sessão(ões)</span></div><p class="overview-copy">${escapeHtml(p.profile.phone||"Sem telefone")} · ${escapeHtml(p.profile.email||"Sem e-mail")}</p><small class="muted">Atualizado em ${formatDate(p.updatedAt)}</small></button>`).join("")}</div></article>`;
