function renderStats() {
  const tp=state.patients.length,ts=state.patients.reduce((s,p)=>s+p.sessions.length,0);
  const wg=state.patients.filter(p=>(p.gallery||[]).length>0).length;
  const fo=getFinanceOverview(),so=getScheduleOverview();
  const stats=[
    {label:"Pacientes",value:tp,helper:"cadastros ativos",action:"open-overview-view",view:"patients"},
    {label:"Sessões",value:ts,helper:"registros de sedação",action:"open-overview-view",view:"sessions"},
    {label:"Galeria",value:wg,helper:"pacientes com imagens",action:"open-overview-view",view:"gallery"},
    {label:"Receita lançada",value:formatMoney(fo.receita),helper:"controle financeiro geral",action:"open-finance-view"},
    {label:"Agenda",value:so.month,helper:"consultas neste mês",action:"open-agenda-view"}
  ];
  const tmpl=document.getElementById("statCardTemplate");els.statsGrid.innerHTML="";
  stats.forEach(st=>{const n=tmpl.content.firstElementChild.cloneNode(true);n.querySelector(".stat-label").textContent=st.label;n.querySelector(".stat-value").textContent=st.value;n.querySelector(".stat-helper").textContent=st.helper;n.dataset.action=st.action;if(st.view)n.dataset.view=st.view;els.statsGrid.appendChild(n);});
}

function renderHomeAlerts() {
  const today=new Date();today.setHours(0,0,0,0);
  const alerts=getScheduleEntries().filter(e=>e.date&&e.status!=="Cancelada").map(e=>{const ed=new Date(`${e.date}T00:00:00`);if(isNaN(ed.getTime()))return null;const diff=Math.floor((ed.getTime()-today.getTime())/(1000*60*60*24));if(diff<0)return null;return {...e,daysRemaining:diff};}).filter(Boolean).sort((a,b)=>(`${String(a.daysRemaining).padStart(4,"0")} ${a.date}`).localeCompare(`${String(b.daysRemaining).padStart(4,"0")} ${b.date}`)).slice(0,3);
  if(!alerts.length){els.homeAlerts.innerHTML=`<article class="surface-card home-alerts-card"><div class="home-alerts-header"><div><p class="eyebrow">Avisos</p><h3>Próximas consultas</h3></div><span class="overview-chip">Sem alertas</span></div><div class="home-alerts-empty"><p class="muted">Nenhuma consulta futura agendada.</p></div></article>`;return;}
  els.homeAlerts.innerHTML=`<article class="surface-card home-alerts-card"><div class="home-alerts-header"><div><p class="eyebrow">Avisos</p><h3>Próximas consultas</h3></div><span class="overview-chip">${alerts.length} aviso(s)</span></div><div class="home-alerts-grid">${alerts.map(e=>{const l=e.daysRemaining<=0?{value:"Hoje",helper:"consulta marcada para hoje"}:e.daysRemaining===1?{value:"1",helper:"dia para a consulta"}:{value:String(e.daysRemaining),helper:"dias para a consulta"};return`<button type="button" class="home-alert-item" data-action="open-agenda-entry" data-schedule-id="${e.id}"><div class="home-alert-countdown ${e.daysRemaining===0?"is-today":""}"><strong>${escapeHtml(l.value)}</strong><span>${escapeHtml(l.helper)}</span></div><div class="home-alert-copy"><p class="card-heading">${escapeHtml(e.patientId?getPatientNameById(e.patientId):"Sem paciente")}</p><p>${escapeHtml(e.appointmentType||"Consulta")}</p><small class="muted">${escapeHtml(formatDate(e.date))}${e.startTime?` • ${escapeHtml(formatTime(e.startTime))}`:""}</small></div></button>`;}).join("")}</div></article>`;
}

function renderPatientList() {
  const filtered=state.patients.filter(p=>{const h=`${p.profile.fullName} ${p.profile.phone} ${p.profile.email}`.toLowerCase();return h.includes(state.search.toLowerCase());});
  if(!filtered.length){els.patientList.innerHTML='<div class="patient-card"><p class="muted">Nenhum paciente encontrado.</p></div>';return;}
  els.patientList.innerHTML=filtered.map(p=>{const active=p.id===state.selectedPatientId?"active":"";const ls=p.sessions[0]?.date?formatDate(p.sessions[0].date):"Sem sessão";return`<article class="patient-card ${active}"><button type="button" data-action="select-patient" data-patient-id="${p.id}"><strong>${escapeHtml(p.profile.fullName||"Paciente sem nome")}</strong><div class="patient-meta"><span>${escapeHtml(p.profile.phone||"Sem telefone")}</span><span>${escapeHtml(ls)}</span></div></button></article>`;}).join("");
}

function renderTabs() {
