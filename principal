function saveAll() {
  const db = readDb();
  db.patients = state.patients;
  db.settings = state.settings;
  writeDb(db);
}

function savePatient() {
  const patient = getSelectedPatient();
  state.saving = true; renderSaveBadge();
  try {
    if (patient) {
      patient.updatedAt = new Date().toISOString();
      const idx = state.patients.findIndex(p=>p.id===patient.id);
      if (idx >= 0) state.patients[idx] = patient;
    }
    saveAll();
    markSaved("SedaFlow salvo");
    render();
  } catch(e) {
    markDirty(e.message);
    alert(e.message);
  } finally {
    state.saving = false; renderSaveBadge();
  }
}

function saveSettingsWorkspace(msg="Configurações salvas") {
  state.saving = true; renderSaveBadge();
  try { saveAll(); markSaved(msg); render(); }
  catch(e) { markDirty(e.message); alert(e.message); }
  finally { state.saving = false; renderSaveBadge(); }
}

function saveActiveWorkspace() {
  if (state.activeView==="agenda") { saveSettingsWorkspace("Agenda salva"); return; }
  if (state.activeView==="finance") { saveSettingsWorkspace("Financeiro salvo"); return; }
  if (state.activeView==="email") { saveSettingsWorkspace("E-mail salvo"); return; }
  if (state.activeView==="system") { saveSettingsWorkspace("Configurações salvas"); return; }
  savePatient();
}

async function loadPatients() {
  const db = readDb();
  state.patients = Array.isArray(db.patients) ? db.patients.map(normalizePatient) : [];
  state.settings = normalizeSettings(db.settings || {});
  render();
}

