// ─── FINANCEIRO ───────────────────────────────────────────────────────────────
function getVariableCostTotal(s=state.settings){return(s.costItems||[]).reduce((sum,i)=>sum+asNumber(i.unitCost)*asNumber(i.quantity||1),0);}
function getTotalInvestment(s=state.settings){return(s.investments||[]).reduce((sum,i)=>sum+asNumber(i.value),0);}
function getMonthlyDepreciation(s=state.settings){return(s.investments||[]).reduce((sum,i)=>{const y=asNumber(i.usefulLifeYears);if(!y)return sum;return sum+asNumber(i.value)/(y*12);},0);}
function getSessionTypeMeta(id){return SESSION_TYPES.find(i=>i.id===id)||SESSION_TYPES[1];}
function getDefaultFeeByType(id,s=state.settings){const m=getSessionTypeMeta(id);return asNumber(s.pricing[m.pricingKey]);}
function getSessionEstimatedCost(session,s=state.settings){if(!session)return 0;const mc=asNumber(session.finance?.variableCostOverride);if(mc>0)return mc;const m=getSessionTypeMeta(session.finance?.sessionType);return getVariableCostTotal(s)*m.costMultiplier;}
function getSessionPlannedFee(session,s=state.settings){if(!session)return 0;const af=asNumber(session.finance?.agreedFee),eh=asNumber(session.finance?.extraHours);if(af>0)return af+eh*asNumber(s.pricing.additionalHour);return getDefaultFeeByType(session.finance?.sessionType,s)+eh*asNumber(s.pricing.additionalHour);}
function getSessionMarkup(session,s=state.settings){const cc=asNumber(session?.finance?.clinicCharge);if(!cc)return 0;return cc-getSessionPlannedFee(session,s);}
function getMonthlySimulationRows(s=state.settings){const vc=getVariableCostTotal(s);return SESSION_TYPES.map(m=>{const q=asNumber(s.monthlySimulation[m.quantityKey]),fee=getDefaultFeeByType(m.id,s),ec=vc*m.costMultiplier;return{...m,quantity:q,fee,gross:fee*q,variableCost:ec*q,margin:(fee-ec)*q};});}
function getFinanceEntryTotal(e){return asNumber(e.quantity)*asNumber(e.unitValue);}
function getFinanceOverview(s=state.settings){const t={receita:0,custo:0,investimento:0,reembolso:0,outro:0};(s.financeEntries||[]).forEach(e=>{const tot=getFinanceEntryTotal(e);if(e.movementType==="Receita")t.receita+=tot;else if(e.movementType==="Custo variável")t.custo+=tot;else if(e.movementType==="Investimento")t.investimento+=tot;else if(e.movementType==="Reembolso")t.reembolso+=tot;else t.outro+=tot;});return{...t,saldo:t.receita+t.reembolso-t.custo-t.investimento};}

