<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>SedaFlow</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
:root {
  --bg: #eaf3ff;
  --bg-strong: #d7e7ff;
  --panel: rgba(255, 255, 255, 0.9);
  --panel-strong: #ffffff;
  --line: #c8daf8;
  --line-strong: #adc7f2;
  --text: #12345c;
  --muted: #5c7aa2;
  --accent: #4068ea;
  --accent-2: #58ace9;
  --accent-strong: #263fbe;
  --accent-soft: #e8f2ff;
  --sidebar-bg: #0e2046;
  --sidebar-bg-2: #1d3181;
  --sidebar-line: rgba(160, 194, 255, 0.16);
  --danger: #b53f56;
  --danger-soft: #ffe7ec;
  --warning-bg: #eef4ff;
  --warning-line: #bdd3ff;
  --warning-text: #31529a;
  --shadow: 0 22px 55px rgba(41, 78, 145, 0.12);
  --shadow-soft: 0 12px 28px rgba(41, 78, 145, 0.08);
}
* { box-sizing: border-box; }
html, body {
  margin: 0; min-height: 100%;
  font-family: "Montserrat", sans-serif;
  background: radial-gradient(circle at top left, rgba(88,172,233,0.22), transparent 28%),
    radial-gradient(circle at bottom right, rgba(64,104,234,0.18), transparent 24%),
    linear-gradient(180deg, #f4f9ff 0%, #e8f1ff 100%);
  color: var(--text);
}
body::before {
  content: ""; position: fixed; inset: 0; pointer-events: none;
  background-image: linear-gradient(rgba(255,255,255,0.26) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,0.26) 1px, transparent 1px);
  background-size: 48px 48px; opacity: 0.28;
}
button, input, select, textarea { font: inherit; }
button { cursor: pointer; }
.hidden { display: none !important; }
.auth-gate { min-height: 100vh; display: grid; place-items: center; padding: 32px; }
.auth-card {
  width: min(100%, 760px); padding: 34px; border-radius: 32px;
  border: 1px solid rgba(173,199,242,0.72);
  background: linear-gradient(180deg, rgba(255,255,255,0.95) 0%, rgba(245,250,255,0.98) 100%);
  box-shadow: var(--shadow);
}
.auth-branding { display: grid; grid-template-columns: 180px 1fr; gap: 28px; align-items: center; margin-bottom: 28px; }
.auth-branding h2 { margin: 0 0 10px; font-size: clamp(1.8rem, 4vw, 2.6rem); line-height: 1.05; letter-spacing: -0.04em; }
.auth-copy { margin: 0; color: var(--muted); line-height: 1.7; }
.auth-logo { width: 100%; max-width: 160px; justify-self: center; display: flex; align-items: center; justify-content: center; }
.auth-logo-placeholder {
  width: 120px; height: 120px; border-radius: 24px;
  background: linear-gradient(135deg, var(--accent-2), var(--accent));
  display: flex; align-items: center; justify-content: center;
  color: white; font-size: 2.4rem; font-weight: 800; letter-spacing: -0.04em;
}
.auth-form { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; align-items: end; }
.auth-form .primary-button { min-height: 54px; }
.auth-error {
  margin: 0; padding: 14px 16px; border-radius: 16px;
  border: 1px solid rgba(181,63,86,0.18); background: rgba(255,231,236,0.88);
  color: var(--danger); font-weight: 600; grid-column: 1 / -1;
}
.auth-session-info { margin: 16px 0 0; color: rgba(233,242,255,0.9); font-size: 0.92rem; }
.app-frame { position: relative; display: grid; grid-template-columns: 340px 1fr; min-height: 100vh; }
.sidebar {
  position: relative; z-index: 1; padding: 30px 24px;
  border-right: 1px solid var(--sidebar-line);
  background: radial-gradient(circle at top left, rgba(88,172,233,0.28), transparent 26%),
    linear-gradient(180deg, var(--sidebar-bg) 0%, var(--sidebar-bg-2) 100%);
  color: #eff5ff; box-shadow: inset -1px 0 0 rgba(255,255,255,0.04);
}
.sidebar::after {
  content: ""; position: absolute; right: 24px; bottom: 24px;
  width: 132px; height: 132px; border-radius: 50%;
  background: radial-gradient(circle, rgba(88,172,233,0.16), transparent 68%); filter: blur(6px);
}
.brand, .sidebar-actions, .patient-list { position: relative; z-index: 1; }
.brand {
  padding: 20px; border-radius: 28px;
  background: linear-gradient(180deg, rgba(255,255,255,0.1) 0%, rgba(255,255,255,0.04) 100%);
  border: 1px solid rgba(196,220,255,0.16); box-shadow: var(--shadow-soft);
}
.brand-logo-button { display: inline-flex; padding: 0; margin: 0 0 18px; border: none; background: transparent; cursor: pointer; }
.brand-logo-placeholder {
  width: 180px; height: 52px; border-radius: 12px;
  background: linear-gradient(135deg, rgba(88,172,233,0.4), rgba(64,104,234,0.3));
  display: flex; align-items: center; justify-content: center;
  color: white; font-size: 1.2rem; font-weight: 800; letter-spacing: -0.03em;
}
.brand h1, .dashboard-header h2, .workspace-header h3, .empty-panel h3 {
  margin: 0; font-family: "Montserrat", sans-serif; font-weight: 700; letter-spacing: -0.03em;
}
.brand h1 { color: #ffffff; font-size: 1.7rem; }
.brand-copy, .header-copy, .workspace-copy, .empty-panel p, .field small, .section-copy, .muted { color: var(--muted); }
.brand-copy { color: rgba(233,242,255,0.82); line-height: 1.55; }
.eyebrow { margin: 0 0 8px; text-transform: uppercase; letter-spacing: 0.16em; font-size: 0.72rem; font-weight: 700; color: var(--accent-2); }
.sidebar .eyebrow { color: #8fd2ff; }
.sidebar-actions { display: grid; gap: 14px; margin: 24px 0; }
.sidebar-actions button { width: 100%; }
.primary-button, .secondary-button, .sync-button, .danger-button, .ghost-button, .chip-button {
  display: inline-flex; align-items: center; justify-content: center;
  border: none; border-radius: 16px; padding: 13px 16px; font-weight: 600;
  text-decoration: none;
  transition: transform 120ms ease, box-shadow 120ms ease, background 120ms ease;
}
.primary-button:hover, .secondary-button:hover, .sync-button:hover, .danger-button:hover, .ghost-button:hover, .chip-button:hover { transform: translateY(-1px); }
.primary-button { background: linear-gradient(135deg, var(--accent-2) 0%, var(--accent) 52%, var(--accent-strong) 100%); color: #fff; box-shadow: 0 16px 32px rgba(64,104,234,0.3); }
.secondary-button { background: var(--accent-soft); color: var(--accent-strong); border: 1px solid rgba(88,172,233,0.18); }
.sync-button { background: #4e8fe8; color: #ffffff; border: 1px solid rgba(255,255,255,0.12); box-shadow: 0 14px 28px rgba(37,87,170,0.24); }
.danger-button { background: var(--danger-soft); color: var(--danger); }
.ghost-button, .chip-button { background: rgba(255,255,255,0.78); border: 1px solid var(--line); color: var(--text); }
.search-field, .field { display: grid; gap: 8px; }
.search-field span, .field span, .section-heading, .card-heading { font-weight: 600; }
.search-field span { color: rgba(237,243,255,0.92); }
input, select, textarea {
  width: 100%; border-radius: 16px; border: 1px solid var(--line);
  background: rgba(255,255,255,0.96); padding: 13px 14px; color: var(--text);
  box-shadow: inset 0 1px 0 rgba(255,255,255,0.7);
}
.sidebar input { background: rgba(255,255,255,0.12); color: #ffffff; border-color: rgba(181,212,255,0.24); }
.sidebar input::placeholder { color: rgba(226,238,255,0.72); }
input:focus, select:focus, textarea:focus { outline: 2px solid rgba(88,172,233,0.2); border-color: var(--accent); }
textarea { min-height: 96px; resize: vertical; }
.patient-list { display: grid; gap: 12px; }
.patient-card { border: 1px solid rgba(183,209,255,0.12); background: rgba(255,255,255,0.08); border-radius: 20px; padding: 15px; backdrop-filter: blur(10px); }
.patient-card.active { border-color: rgba(143,210,255,0.38); background: linear-gradient(180deg, rgba(95,184,235,0.18) 0%, rgba(255,255,255,0.1) 100%); box-shadow: 0 12px 24px rgba(15,29,73,0.18); }
.patient-card button { width: 100%; background: transparent; border: none; padding: 0; text-align: left; color: inherit; }
.patient-card strong { display: block; margin-bottom: 6px; color: #ffffff; }
.patient-meta { display: flex; flex-wrap: wrap; gap: 8px; font-size: 0.85rem; color: rgba(227,238,255,0.76); }
.main-content { position: relative; z-index: 1; padding: 32px; }
.dashboard-header, .empty-panel, .workspace, .surface-card {
  background: var(--panel); border: 1px solid rgba(173,199,242,0.5);
  border-radius: 30px; box-shadow: var(--shadow); backdrop-filter: blur(12px);
}
.dashboard-header {
  display: grid;
  grid-template-columns: minmax(0, 1.16fr) minmax(240px, 0.84fr);
  grid-template-areas: "copy logo" "stats stats";
  gap: 24px; padding: 28px;
  background: radial-gradient(circle at top right, rgba(88,172,233,0.18), transparent 28%),
    linear-gradient(180deg, rgba(255,255,255,0.92) 0%, rgba(237,245,255,0.88) 100%);
}
.dashboard-header.is-collapsed { grid-template-columns: 1fr; grid-template-areas: "stats"; gap: 0; padding: 18px 20px; }
.dashboard-header.is-collapsed .hero-copy-block, .dashboard-header.is-collapsed .hero-logo-shell { display: none; }
.dashboard-header.is-collapsed .stats-grid { gap: 10px; grid-template-columns: repeat(5, minmax(0, 1fr)); }
.dashboard-header.is-collapsed .stat-card { padding: 12px 14px; border-radius: 18px; }
.dashboard-header.is-collapsed .stat-label { font-size: 0.82rem; }
.dashboard-header.is-collapsed .stat-value { font-size: 1rem; }
.dashboard-header.is-collapsed .stat-helper { display: none; }
.hero-copy-block { grid-area: copy; display: flex; flex-direction: column; justify-content: center; }
.dashboard-header h2 { max-width: 760px; font-size: clamp(2rem, 3vw, 3rem); line-height: 1.05; color: #1b3f74; }
.hero-panel { grid-area: logo; display: flex; align-items: center; justify-content: flex-end; }
.hero-logo-shell { display: flex; align-items: center; justify-content: flex-end; min-height: 100%; padding: 6px 0 6px 12px; }
.hero-logo-placeholder {
  width: 200px; height: 200px; border-radius: 32px;
  background: linear-gradient(135deg, var(--accent-2), var(--accent));
  display: flex; align-items: center; justify-content: center;
  color: white; font-size: 3rem; font-weight: 800; letter-spacing: -0.04em;
}
.stats-grid { grid-area: stats; display: grid; gap: 14px; grid-template-columns: repeat(5, minmax(0, 1fr)); }
.stat-card { border-radius: 22px; padding: 18px; background: linear-gradient(180deg, rgba(88,172,233,0.12) 0%, rgba(255,255,255,0.95) 100%); border: 1px solid rgba(88,172,233,0.18); box-shadow: var(--shadow-soft); }
.stat-card-button { width: 100%; text-align: left; cursor: pointer; font: inherit; appearance: none; transition: transform 160ms ease, box-shadow 160ms ease, border-color 160ms ease; }
.stat-card-button:hover { transform: translateY(-2px); border-color: rgba(64,104,234,0.26); box-shadow: 0 16px 34px rgba(64,104,234,0.12); }
.stat-label { display: block; font-size: 0.8rem; font-weight: 700; color: var(--muted); margin-bottom: 6px; }
.stat-value { display: block; font-size: 1.5rem; font-weight: 800; color: var(--text); letter-spacing: -0.03em; }
.stat-helper { display: block; font-size: 0.78rem; color: var(--muted); margin-top: 4px; }
.home-alerts { margin-top: 24px; }
.home-alerts-card { padding: 24px; }
.home-alerts-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 18px; }
.home-alerts-header h3 { margin: 0; }
.home-alerts-grid { display: grid; gap: 14px; grid-template-columns: repeat(3, 1fr); }
.home-alert-item { display: flex; gap: 16px; align-items: center; padding: 16px; border-radius: 20px; border: 1px solid var(--line); background: rgba(255,255,255,0.8); text-align: left; font: inherit; color: inherit; transition: transform 120ms ease; }
.home-alert-item:hover { transform: translateY(-1px); }
.home-alert-countdown { display: grid; gap: 2px; min-width: 64px; text-align: center; padding: 10px; border-radius: 14px; background: var(--accent-soft); }
.home-alert-countdown strong { font-size: 1.6rem; font-weight: 800; color: var(--accent-strong); }
.home-alert-countdown span { font-size: 0.72rem; color: var(--muted); font-weight: 600; }
.home-alert-countdown.is-today { background: linear-gradient(135deg, var(--accent-2), var(--accent)); }
.home-alert-countdown.is-today strong, .home-alert-countdown.is-today span { color: white; }
.home-alert-copy p { margin: 0 0 4px; }
.home-alerts-empty { padding: 16px 0; }
.workspace { margin-top: 24px; }
.workspace-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 20px; padding: 24px 28px; border-bottom: 1px solid var(--line); }
.workspace-header h3 { font-size: 1.5rem; letter-spacing: -0.03em; }
.workspace-actions { display: flex; gap: 10px; flex-shrink: 0; align-items: center; flex-wrap: wrap; }
.save-badge { padding: 8px 14px; border-radius: 12px; font-size: 0.82rem; font-weight: 600; color: var(--muted); background: rgba(255,255,255,0.6); border: 1px solid var(--line); }
.save-badge.dirty { color: #b06d00; background: #fff8e8; border-color: #f5d98a; }
.save-badge.success { color: #1a7a3e; background: #eafaf0; border-color: #a0e0bc; }
.tab-bar { display: flex; gap: 8px; padding: 16px 28px; border-bottom: 1px solid var(--line); flex-wrap: wrap; }
.tab-button { padding: 10px 18px; border-radius: 14px; border: 1px solid transparent; background: transparent; color: var(--muted); font-weight: 600; font-size: 0.9rem; transition: all 120ms ease; }
.tab-button.active { background: var(--accent-soft); color: var(--accent-strong); border-color: rgba(88,172,233,0.2); }
.tab-button:hover:not(.active) { background: rgba(255,255,255,0.8); color: var(--text); }
.tab-content { padding: 28px; display: grid; gap: 24px; }
.section-block { padding: 24px; }
.section-block + .section-block { margin-top: 0; }
.section-heading { margin: 0 0 16px; font-size: 1.05rem; }
.section-copy { margin: 0 0 16px; line-height: 1.7; }
.form-grid { display: grid; grid-template-columns: repeat(12, 1fr); gap: 16px; }
.span-2 { grid-column: span 2; }
.span-3 { grid-column: span 3; }
.span-4 { grid-column: span 4; }
.span-5 { grid-column: span 5; }
.span-6 { grid-column: span 6; }
.span-7 { grid-column: span 7; }
.span-8 { grid-column: span 8; }
.span-9 { grid-column: span 9; }
.span-12 { grid-column: span 12; }
.check-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
.binary-field { display: grid; gap: 8px; padding: 14px; border-radius: 18px; border: 1px solid var(--line); background: rgba(255,255,255,0.6); }
.binary-field p { margin: 0; font-size: 0.9rem; font-weight: 600; }
.quick-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 14px; margin-top: 16px; }
.check-card { display: flex; gap: 10px; align-items: center; padding: 12px 16px; border-radius: 14px; border: 1px solid var(--line); background: rgba(255,255,255,0.6); cursor: pointer; font-size: 0.9rem; }
.check-card input { width: auto; }
.reference-card { padding: 18px; border-radius: 20px; border: 1px solid var(--line); background: rgba(255,255,255,0.7); }
.reference-card p { margin: 0 0 8px; }
.reference-card p:last-child { margin-bottom: 0; }
.mdas-grid { display: grid; gap: 16px; margin: 16px 0; }
.mdas-question { padding: 18px; border-radius: 20px; border: 1px solid var(--line); background: rgba(255,255,255,0.6); }
.mdas-question p { margin: 0 0 12px; }
.score-pill { display: inline-flex; padding: 10px 18px; border-radius: 24px; background: var(--accent-soft); color: var(--accent-strong); font-weight: 700; font-size: 0.92rem; margin-top: 8px; }
.session-selector { display: flex; gap: 12px; align-items: flex-end; margin-bottom: 20px; flex-wrap: wrap; }
.session-selector .field { flex: 1; }
.table-like { display: grid; gap: 12px; margin-top: 16px; }
.table-row { display: grid; grid-template-columns: repeat(5, 1fr) auto; gap: 10px; align-items: end; padding: 16px; border-radius: 18px; border: 1px solid var(--line); background: rgba(255,255,255,0.6); }
.table-row.compact { grid-template-columns: 1fr 2fr 2fr auto; }
.wilson-reference-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 14px; margin-top: 16px; }
.wilson-reference-card { border-left: 3px solid var(--accent-2); }
.trieger-preview { width: 100%; max-width: 260px; border-radius: 14px; margin-top: 12px; border: 1px solid var(--line); }
.finance-kpi-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin-top: 16px; }
.finance-kpi-card { padding: 18px; border-radius: 20px; border: 1px solid var(--line); background: linear-gradient(180deg, rgba(88,172,233,0.08) 0%, rgba(255,255,255,0.95) 100%); }
.finance-kpi-card .stat-value { font-size: 1.2rem; }
.finance-title { margin: 0 0 16px; font-size: 1.1rem; line-height: 1.4; }
.card-toolbar { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; margin-bottom: 18px; }
.finance-toolbar { align-items: center; }
.toolbar-actions { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }
.finance-table { display: grid; gap: 12px; margin-top: 16px; }
.finance-table-row { display: grid; grid-template-columns: 2fr 1fr 1fr auto auto; gap: 10px; align-items: end; padding: 16px; border-radius: 18px; border: 1px solid var(--line); background: rgba(255,255,255,0.6); }
.finance-investment-row { grid-template-columns: 2fr 1fr 1fr auto auto; }
.finance-simulation-row { grid-template-columns: 2fr 1fr 1fr 1fr 1fr; }
.finance-entry-row { display: grid; grid-template-columns: 1fr 1.5fr 1fr 2fr 0.6fr 0.8fr 1fr auto auto; gap: 10px; align-items: end; padding: 16px; border-radius: 18px; border: 1px solid var(--line); background: rgba(255,255,255,0.6); }
.finance-notes-field { grid-column: span 2; }
.finance-inline-total { display: grid; gap: 4px; text-align: center; }
.finance-inline-total span { font-size: 0.78rem; color: var(--muted); font-weight: 600; }
.finance-inline-total strong { font-weight: 700; }
.finance-balance-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin-top: 20px; }
.info-banner { padding: 14px 18px; border-radius: 16px; background: var(--warning-bg); border: 1px solid var(--warning-line); color: var(--warning-text); font-size: 0.92rem; margin-top: 16px; }
.calendar-weekdays { display: grid; grid-template-columns: repeat(7, 1fr); gap: 8px; margin-bottom: 8px; text-align: center; font-size: 0.8rem; font-weight: 700; color: var(--muted); }
.calendar-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 8px; }
.calendar-empty { border-radius: 16px; min-height: 80px; }
.calendar-day-card { border-radius: 16px; padding: 12px; border: 1px solid var(--line); background: rgba(255,255,255,0.7); text-align: left; font: inherit; color: inherit; cursor: pointer; min-height: 80px; display: grid; gap: 4px; transition: transform 120ms ease; }
.calendar-day-card:hover { transform: translateY(-2px); box-shadow: var(--shadow-soft); }
.calendar-day-card.selected { border-color: var(--accent); background: var(--accent-soft); }
.calendar-day-card.today { border-color: var(--accent-2); }
.calendar-day-card.has-entries { background: linear-gradient(135deg, rgba(88,172,233,0.15), rgba(255,255,255,0.9)); }
.calendar-day-card strong { font-size: 1.1rem; color: var(--text); }
.calendar-day-card span { font-size: 0.75rem; color: var(--muted); font-weight: 600; }
.calendar-day-card small { font-size: 0.72rem; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.calendar-day-card.schedule-tone-sedation { border-color: rgba(64,104,234,0.4); background: linear-gradient(135deg, rgba(64,104,234,0.1), rgba(255,255,255,0.95)); }
.calendar-day-card.schedule-tone-assessment { border-color: rgba(88,172,233,0.4); background: linear-gradient(135deg, rgba(88,172,233,0.1), rgba(255,255,255,0.95)); }
.calendar-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; }
.schedule-list { display: grid; gap: 12px; }
.schedule-item-card { padding: 16px 20px; border-radius: 20px; border: 1px solid var(--line); background: rgba(255,255,255,0.7); display: flex; justify-content: space-between; align-items: flex-start; gap: 14px; }
.schedule-item-button { width: 100%; text-align: left; font: inherit; color: inherit; cursor: pointer; transition: transform 120ms ease; }
.schedule-item-button:hover { transform: translateY(-1px); }
.schedule-item-button.active { border-color: var(--accent); background: var(--accent-soft); }
.schedule-item-button.schedule-tone-sedation { border-color: rgba(64,104,234,0.3); }
.schedule-item-button.schedule-tone-assessment { border-color: rgba(88,172,233,0.3); }
.schedule-item-card .toolbar-actions { flex-shrink: 0; }
.agenda-layout { display: grid; grid-template-columns: 1fr 1.2fr; gap: 20px; }
.appointment-editor-card { padding: 20px; }
.appointment-editor-toolbar { margin-bottom: 16px; }
.appointment-editor-grid { margin-top: 0; }
.schedule-month-picker { min-width: 160px; }
.overview-chip { display: inline-flex; padding: 5px 12px; border-radius: 24px; background: var(--accent-soft); color: var(--accent-strong); font-size: 0.78rem; font-weight: 700; flex-shrink: 0; }
.overview-section-header { display: flex; justify-content: space-between; gap: 16px; align-items: flex-start; margin-bottom: 18px; }
.overview-stack { display: grid; gap: 14px; }
