// ─── EVENT HANDLERS ───────────────────────────────────────────────────────────
document.addEventListener("input", e => {
  if(e.target.dataset.sessionField){setValueAtPath(getSelectedSession(),e.target.dataset.sessionField,e.target.value);markDirty();return;}
  if(e.target.dataset.settingsPath){setValueAtPath(state.settings,e.target.dataset.settingsPath,e.target.value);if(["finance","system","email"].includes(state.activeView))markDirty("Configurações alteradas");else markDirty("Financeiro alterado");return;}
  if(e.target.dataset.settingsRowType){updateSettingsRow(e.target.dataset.settingsRowType,e.target.dataset.settingsRowId,e.target.dataset.settingsRowField,e.target.value);return;}
  if(e.target.dataset.path){
    const p=getSelectedPatient();if(!p)return;
    setValueAtPath(p,e.target.dataset.path,e.target.value);
    if(e.target.dataset.path==="profile.birthDate"){p.profile.age=calculateAgeFromBirthDate(e.target.value);const af=document.querySelector("[data-derived-age='true']");if(af)af.value=p.profile.age;}
    if(e.target.dataset.path==="profile.nationality"&&e.target.value!=="Outra")p.profile.otherNationality="";
    markDirty();return;
  }
  if(e.target.dataset.sessionRow){updateSessionRow(e.target.dataset.sessionRow,e.target.dataset.rowId,e.target.dataset.rowField,e.target.value);return;}
  if(e.target.dataset.scheduleField){
    const entry=getSelectedScheduleEntry();if(!entry)return;
    entry[e.target.dataset.scheduleField]=e.target.value;
    if(e.target.dataset.scheduleField==="date"&&e.target.value)state.scheduleMonth=e.target.value.slice(0,7);
    markDirty("Agenda alterada");
    if(["patientId","status","appointmentType"].includes(e.target.dataset.scheduleField))renderWorkspace();
  }
});

document.addEventListener("change", e => {
  if(e.target.dataset.documentUpload){
    const file=e.target.files?.[0];if(!file)return;
    fileToDataUrl(file).then(url=>{
      const p=getSelectedPatient();if(!p)return;
      setValueAtPath(p,e.target.dataset.documentUpload,url);
      if(e.target.dataset.documentUploadName)setValueAtPath(p,e.target.dataset.documentUploadName,file.name);
      markDirty();renderWorkspace();
    }).catch(err=>alert(err.message));return;
  }
  if(e.target.dataset.triegerImage){
    const file=e.target.files?.[0];if(!file)return;
    fileToDataUrl(file).then(url=>{
      const s=getSelectedSession();if(!s)return;
      setValueAtPath(s,e.target.dataset.triegerImage,url);markDirty();renderWorkspace();
    }).catch(err=>alert(err.message));return;
  }
  if(e.target.dataset.sessionField){const s=getSelectedSession();if(!s)return;setValueAtPath(s,e.target.dataset.sessionField,e.target.value);markDirty();renderWorkspace();return;}
  if(e.target.dataset.settingsPath){setValueAtPath(state.settings,e.target.dataset.settingsPath,e.target.value);markDirty("Financeiro alterado");if(["finance","system","email"].includes(state.activeView))renderWorkspace();return;}
  if(e.target.dataset.settingsRowType){updateSettingsRow(e.target.dataset.settingsRowType,e.target.dataset.settingsRowId,e.target.dataset.settingsRowField,e.target.value);if(["finance","system","email"].includes(state.activeView))renderWorkspace();return;}
  if(e.target.dataset.path){
    const p=getSelectedPatient();if(!p)return;setValueAtPath(p,e.target.dataset.path,e.target.value);
    if(e.target.dataset.path==="profile.nationality"&&e.target.value!=="Outra"){p.profile.otherNationality="";renderWorkspace();}
    markDirty();return;
  }
  if(e.target.dataset.arrayPath){
    const p=getSelectedPatient();if(!p)return;
    const cur=getValueAtPath(p,e.target.dataset.arrayPath)||[];
    const next=new Set(cur);
    if(e.target.checked)next.add(e.target.dataset.arrayValue);else next.delete(e.target.dataset.arrayValue);
    setValueAtPath(p,e.target.dataset.arrayPath,[...next]);markDirty();return;
  }
  if(e.target.dataset.mdasIndex){
    const p=getSelectedPatient();if(!p)return;
    p.anxiety.mdasAnswers[Number(e.target.dataset.mdasIndex)]=Number(e.target.value);markDirty();renderWorkspace();return;
  }
  if(e.target.id==="sessionSelector"){state.selectedSessionId=e.target.value;renderWorkspace();return;}
  if(e.target.id==="scheduleMonthInput"){state.scheduleMonth=e.target.value||new Date().toISOString().slice(0,7);renderWorkspace();return;}
});

document.addEventListener("click", async e => {
  const t=e.target.closest("[data-action]");if(!t)return;
  const action=t.dataset.action;
  if(action==="select-patient"){openPatientView("cadastro",t.dataset.patientId);return;}
  if(action==="switch-tab"){state.activeView="patient";state.activeTab=t.dataset.tab;renderWorkspace();return;}
  if(action==="open-overview-view"){openOverviewView(t.dataset.view);return;}
  if(action==="open-finance-view"){openFinanceView();return;}
  if(action==="open-email-view"){openEmailView();return;}
  if(action==="open-agenda-view"){openAgendaView();return;}
  if(action==="open-system-view"){openSystemView();return;}
  if(action==="open-patient-record"){openPatientView("cadastro",t.dataset.patientId);return;}
  if(action==="open-session-record"){openSessionRecord(t.dataset.patientId,t.dataset.sessionId);return;}
  if(action==="open-gallery-record"){openGalleryRecord(t.dataset.patientId);return;}
  if(action==="open-agenda-entry"){openAgendaView(t.dataset.scheduleId);return;}
  if(action==="open-linked-patient"){openPatientView("consultas",t.dataset.patientId);return;}
  if(action==="switch-anamnese-section"){state.anamneseSection=t.dataset.anamneseSection;renderWorkspace();return;}
  if(action==="create-session"){addSession();return;}
  if(action==="delete-session"){deleteSession();return;}
  if(action==="add-session-row"){addSessionRow(t.dataset.sessionRow);return;}
  if(action==="remove-session-row"){removeSessionRow(t.dataset.sessionRow,t.dataset.rowId);return;}
  if(action==="add-settings-row"){addSettingsRow(t.dataset.settingsRowType);return;}
  if(action==="remove-settings-row"){removeSettingsRow(t.dataset.settingsRowType,t.dataset.settingsRowId);return;}
  if(action==="save-finance-now"){saveSettingsWorkspace("Financeiro salvo");return;}
  if(action==="change-schedule-month"){const d=Number(t.dataset.direction||0);state.scheduleMonth=d===0?new Date().toISOString().slice(0,7):shiftMonthValue(state.scheduleMonth,d);renderWorkspace();return;}
  if(action==="create-schedule-entry"){createScheduleEntry(t.dataset.scheduleDate||"");return;}
  if(action==="open-schedule-day"){openScheduleDay(t.dataset.scheduleDate);return;}
  if(action==="delete-schedule-entry"){deleteSelectedScheduleEntry();return;}
  if(action==="save-schedule-entry"){saveSettingsWorkspace("Agendamento salvo");alert("Agendamento salvo com sucesso.");return;}
  if(action==="create-patient-appointment"){createScheduleEntry("",t.dataset.patientId);return;}
  if(action==="link-schedule-to-patient"){const sid=document.getElementById("patientAppointmentSelector")?.value||"";if(!sid){alert("Selecione um horário livre para associar.");return;}linkScheduleToPatient(t.dataset.patientId,sid);return;}
  if(action==="unlink-schedule-from-patient"){unlinkScheduleFromPatient(t.dataset.scheduleId);return;}
  if(action==="upload-gallery"){await uploadGallery();return;}
  if(action==="delete-image"){deleteImage(t.dataset.imageId);return;}
  if(action==="print-record"){printPatientRecord();return;}
  if(action==="export-json"){exportJson();return;}
  if(action==="import-json"){importJson();return;}
});

els.createPatientButton.addEventListener("click",()=>createPatient());
els.openAgendaButton.addEventListener("click",()=>openAgendaView());
els.openPatientsButton.addEventListener("click",()=>openOverviewView("patients"));
els.homeLogoButton.addEventListener("click",()=>openHomeView());
els.openEmailButton.addEventListener("click",()=>openEmailView());
els.openFinanceButton.addEventListener("click",()=>openFinanceView());
els.openSystemButton.addEventListener("click",()=>openSystemView());
els.logoutButton.addEventListener("click",()=>logoutFromApp());
els.savePatientButton.addEventListener("click",()=>saveActiveWorkspace());
els.exportPatientPdfButton.addEventListener("click",()=>printPatientRecord());
els.deletePatientButton.addEventListener("click",()=>deleteSelectedPatient());
els.patientSearchInput.addEventListener("input",e=>{state.search=e.target.value;renderPatientList();});
els.loginForm.addEventListener("submit",e=>{e.preventDefault();loginToApp();});

// ─── BOOT ─────────────────────────────────────────────────────────────────────
function bootstrapApp() {
  if(checkSession()){
    const db=readDb();
    state.auth={authenticated:true,username:AUTH_USERNAME};
    showAppFrame();loadPatients();updateStorageIndicator();
  } else {
    showAuthGate();
    if(els.loginUsernameInput)els.loginUsernameInput.value=AUTH_USERNAME;
  }
}

bootstrapApp();
</script>
