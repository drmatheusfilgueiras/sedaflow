// ─── STORAGE ──────────────────────────────────────────────────────────────────
function readDb() {
  try {
    const raw = localStorage.getItem(STORAGE_KEY);
    if (!raw) return { patients: [], settings: defaultFinanceSettings() };
    return JSON.parse(raw);
  } catch { return { patients: [], settings: defaultFinanceSettings() }; }
}

function writeDb(data) {
  localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
  updateStorageIndicator();
}

function updateStorageIndicator() {
  try {
    const raw = localStorage.getItem(STORAGE_KEY) || "";
    const bytes = new Blob([raw]).size;
    const kb = (bytes / 1024).toFixed(0);
    const mb = (bytes / 1024 / 1024).toFixed(2);
    const pct = Math.min(100, (bytes / (5 * 1024 * 1024)) * 100);
    const lbl = document.getElementById("storageLabel");
    const fill = document.getElementById("storageFill");
    if (lbl) lbl.textContent = `${kb} KB usados (~5 MB disponível)`;
    if (fill) fill.style.width = `${pct}%`;
  } catch {}
}

function exportJson() {
  const data = readDb();
  const blob = new Blob([JSON.stringify(data, null, 2)], { type: "application/json" });
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url;
  a.download = `sedaflow-backup-${new Date().toISOString().slice(0,10)}.json`;
  a.click();
  URL.revokeObjectURL(url);
}

function importJson() {
  const input = document.createElement("input");
  input.type = "file";
  input.accept = ".json";
  input.onchange = async () => {
    const file = input.files?.[0];
    if (!file) return;
    try {
      const text = await file.text();
      const data = JSON.parse(text);
      if (!data.patients || !Array.isArray(data.patients)) {
        alert("Arquivo inválido. Selecione um backup do SedaFlow.");
        return;
      }
      const confirmed = confirm(`Restaurar backup com ${data.patients.length} paciente(s)?\n\nATENÇÃO: os dados atuais serão substituídos.`);
      if (!confirmed) return;
      writeDb(data);
      await loadPatients();
      alert("Backup restaurado com sucesso!");
    } catch (e) {
      alert("Erro ao importar: " + e.message);
    }
  };
  input.click();
}

