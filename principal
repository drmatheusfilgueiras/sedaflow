  <table><tr><td>Nome completo</td><td>${p.profile.fullName||"—"}</td></tr><tr><td>Data de nascimento</td><td>${p.profile.birthDate?formatDate(p.profile.birthDate):"—"} (${p.profile.age||"—"} anos)</td></tr><tr><td>Sexo</td><td>${p.profile.sex||"—"}</td></tr><tr><td>Telefone</td><td>${p.profile.phone||"—"}</td></tr><tr><td>E-mail</td><td>${p.profile.email||"—"}</td></tr><tr><td>Profissão</td><td>${p.profile.profession||"—"}</td></tr></table>
  <h2>Avaliação Clínica</h2>
  <table><tr><td>Classificação ASA</td><td>${p.clinicalAssessment.asaClass||"—"}</td></tr><tr><td>PA basal</td><td>${p.clinicalAssessment.bloodPressureBaseline||"—"}</td></tr><tr><td>SpO2 basal</td><td>${p.clinicalAssessment.spo2Baseline||"—"}</td></tr><tr><td>Respiração nasal</td><td>${p.clinicalAssessment.nasalBreathing||"—"}</td></tr><tr><td>Observações de via aérea</td><td>${p.clinicalAssessment.airwayNotes||"—"}</td></tr><tr><td>Queixa principal</td><td>${p.treatment.complaint||"—"}</td></tr></table>
