    els.patientSubtitle.textContent="Configuração para referência futura.";els.savePatientButton.textContent="Salvar e-mail";
    els.tabContent.innerHTML=renderEmailTab();return;
  }
  if(av==="system"){
    els.homeAlerts.classList.add("hidden");els.emptyState.classList.add("hidden");els.patientWorkspace.classList.remove("hidden");
    els.tabBar.classList.add("hidden");els.saveBadge.classList.remove("hidden");els.savePatientButton.classList.remove("hidden");
    els.exportPatientPdfButton.classList.add("hidden");els.deletePatientButton.classList.add("hidden");
    els.workspaceEyebrow.textContent="Backup / Dados";els.patientTitle.textContent="Backup e Dados";
    els.patientSubtitle.textContent="Exporte e importe seus dados com segurança.";els.savePatientButton.textContent="Salvar";
    els.tabContent.innerHTML=renderSystemTab();return;
  }
  if(["patients","sessions","gallery"].includes(av)){
    els.homeAlerts.classList.add("hidden");els.emptyState.classList.add("hidden");els.patientWorkspace.classList.remove("hidden");
