  return `<article class="surface-card section-block"><p class="eyebrow">Agenda</p>
  <div class="finance-kpi-grid">
    <article class="finance-kpi-card"><span class="stat-label">Neste mês</span><strong class="stat-value">${ov.month}</strong><small class="stat-helper">consultas em ${escapeHtml(formatMonthLabel(monthValue))}</small></article>
    <article class="finance-kpi-card"><span class="stat-label">Hoje</span><strong class="stat-value">${ov.today}</strong><small class="stat-helper">agendamentos para hoje</small></article>
